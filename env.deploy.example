# Kopieren nach .env.deploy (nicht ins Git einchecken) und Werte setzen.
# NIEMALS echte Root-Passwörter in deploy_system.py oder in Git ablegen.

SKYTYCOON_DEPLOY_HOST=your.server.example
SKYTYCOON_DEPLOY_PORT=22
SKYTYCOON_DEPLOY_USER=deploy
SKYTYCOON_DEPLOY_PASSWORD=
# Optional statt Passwort (oder zusätzlich): OpenSSH-Privatkey
# SKYTYCOON_DEPLOY_KEY_PATH=C:/Users/du/.ssh/id_ed25519
# SKYTYCOON_DEPLOY_KEY_PASSPHRASE=
# Alternative Pfad zur Env-Datei (wird vor CWD/Skript geladen)
# SKYTYCOON_DEPLOY_ENV_FILE=
SKYTYCOON_DEPLOY_REMOTE_DIR=/home/skytycoon
SKYTYCOON_DEPLOY_DOMAIN=skytycoon.info
# 0 = certbot --nginx (TLS); 1 = nur HTTP (Nginx -> uvicorn)
SKYTYCOON_DEPLOY_SKIP_CERTBOT=1

# --- Auf dem Server: SMTP fuer Lizenz-/Aktivierungs-Mails (IONOS) ---
# Empfohlen (ueberlebt ``python deploy_system.py``): Datei nur auf dem Server, nicht ins Git:
#   /home/skytycoon/smtp.env   (chmod 600, Owner root)
# Inhalt z. B. (eine Variable pro Zeile, ohne Anfuehrungszeichen um den Wert):
#   SKYTYCOON_SMTP_HOST=smtp.ionos.de
#   SKYTYCOON_SMTP_PORT=465
#   SKYTYCOON_SMTP_USER=info@skytycoon.info
#   SKYTYCOON_SMTP_PASSWORD=dein-passwort
#   SKYTYCOON_SMTP_FROM=info@skytycoon.info
# Die Unit laedt ``EnvironmentFile=-/home/skytycoon/smtp.env`` (Minus = optional).
# Alternativ: ``sudo systemctl edit skytycoon`` und unter [Service] Environment=... eintragen
# (wird mit der Haupt-Unit zusammengefuehrt). Nach Aenderung: daemon-reload + restart skytycoon.
# --- PayPal (Meilenstein 156, Produktion) ---
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_WEBHOOK_ID=...          # aus PayPal Developer Dashboard → Webhooks
# PAYPAL_SANDBOX=0               # 1 = Sandbox-API
# PAYPAL_PRODUCT_EUR=19.99       # optional, muss zum Button-Betrag passen
# PAYPAL_SKIP_WEBHOOK_VERIFY=0   # nur Tests: 1 = Signaturprüfung überspringen (NICHT in Produktion)
# PAYPAL_MODE=live               # live | sandbox (Sandbox auch mit PAYPAL_SANDBOX=1)
# PAYPAL_ALLOW_SANDBOX=0         # 1 = Sandbox erlaubt (Standard: nur Live api-m.paypal.com)
# Öffentliche Client-ID kann im Code-Default liegen; Secret nur hier:
# PAYPAL_CLIENT_SECRET=...
# SKYTYCOON_JWT_SECRET=...
# SKYTYCOON_DIST_EXE=/home/skytycoon/SkyTycoon_Pro.exe
# HTTP-Port wenn kein SSL (Standard 8000)
SKYTYCOON_DEPLOY_HTTP_PORT=8000
# 1 = systemd skytycoon.service (Meilenstein 148)
SKYTYCOON_DEPLOY_USE_SYSTEMD=0
# 1 = nginx stop+disable (nur sinnvoll ohne SKYTYCOON_DEPLOY_NGINX_PROXY)
SKYTYCOON_DEPLOY_STOP_NGINX=1
# 1 = Nginx reverse proxy :80 -> 127.0.0.1:HTTP_PORT; uvicorn nur lokal; empfohlen fuer Domain im Browser
SKYTYCOON_DEPLOY_NGINX_PROXY=0
# Bei certbot: zusaetzlich www. anfordern (1) oder nur Apex (0)
SKYTYCOON_DEPLOY_CERTBOT_INCLUDE_WWW=1

# Nur prüfen (kein Upload): python deploy_system.py --verify

# Optional: Update-Manifest auf dem Server (Fallback wenn keine ./version.json mitdeployt wird)
# SKYTYCOON_UPDATE_VERSION=1.0.0-GOLD
# SKYTYCOON_UPDATE_EXE_URL=https://example.com/SkyTycoon_Pro_Setup.exe
# SKYTYCOON_UPDATE_CHANGELOG=Wartungsrelease
